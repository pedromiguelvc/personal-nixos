{ lib, ... }:
let
  configDir = ./config;

  luaFiles = lib.filter (name: lib.hasSuffix ".lua" name) (
    builtins.attrNames (builtins.readDir configDir)
  );

  first = "definitions.lua"; # must be loaded first
  ordered =
    lib.optional (lib.elem first luaFiles) first ++ lib.sort lib.lessThan (lib.remove first luaFiles);

  requireLine = file: "require(\"${lib.removeSuffix ".lua" file}\")";
in
{
  xdg.configFile."hypr" = {
    source = configDir;
    recursive = true;
  };

  xdg.configFile."hypr/hyprland.lua".text = ''
    -- Generated by home-modules/hyprland/default.nix. Edit the modules, not this file.
  ''
  + lib.concatMapStringsSep "\n" requireLine ordered
  + "\n";
}
